<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchConfirmDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Confirm before deleting an item"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnClearPantry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Clear all pantry items"
            android:textColor="@color/white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:lineSpacingExtra="3dp"
            android:text="Smart Pantry Manager v1.0\nSuggests recipes using only the ingredients you already have, to help cut food waste."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>
